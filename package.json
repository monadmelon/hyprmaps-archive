{
  "name": "hyprmaps-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "HyprMaps monorepo for frontend, backend, and shared packages",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "lint": "pnpm --filter \"./**\" lint"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.11.0"
  },
  "packageManager": "pnpm@8.15.5"
}